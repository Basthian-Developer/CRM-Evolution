{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "dev:json": "vite --host 0.0.0.0 --port 3000 --mode json",
    "dev:api": "vite --host 0.0.0.0 --port 3000 --mode api",
    "dev:github": "vite --host 0.0.0.0 --port 3000 --mode github-pages",
    "build": "tsc -b && vite build",
    "build:json": "tsc -b && vite build --mode json",
    "build:github": "tsc -b && vite build --mode github-pages",
    "build:api": "tsc -b && vite build --mode api",
    "lint": "eslint .",
    "preview": "vite preview --host 0.0.0.0 --port 3000 --mode json"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-table": "^9.2.4",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
